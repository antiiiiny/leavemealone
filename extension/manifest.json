{
  "manifest_version": 3,
  "name": "leavemealone",
  "version": "1.0.2",
  "description": "Bunk calculator and low-attendance alerts for the CUE student portal. Unofficial; not affiliated with CHRIST University.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://cue.christuniversity.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "leavemealone",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui.css",
        "fonts/SpaceGrotesk.woff2"
      ],
      "matches": [
        "https://cue.christuniversity.in/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cue.christuniversity.in/*"
      ],
      "js": [
        "calc.js",
        "calendar.js",
        "plan.js",
        "ui.js",
        "profile.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
